{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Goldmaker",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "streamlit", "run", "app.py"],
            "isBackground": true,
            "problemMatcher": [],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "panel": "dedicated", "reveal": "always", "clear": true }
        },
        {
            "label": "Run tests",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "pytest", "-q"],
            "problemMatcher": [],
            "group": { "kind": "test", "isDefault": true },
            "presentation": { "panel": "shared", "reveal": "always", "clear": true }
        },
        {
            "label": "Set up / update environment",
            "type": "process",
            "command": "cmd",
            "args": ["/c", "setup_env.bat", "nopause"],
            "problemMatcher": [],
            "presentation": { "panel": "shared", "reveal": "always" }
        }
    ]
}
